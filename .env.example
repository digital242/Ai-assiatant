# Copy this file to ".env" and fill in your key. The .env file is git-ignored.
# This file holds ONLY the secret. All other settings live in config.yaml.
#
# Sumo also reads ANTHROPIC_API_KEY straight from your shell environment, so a
# .env file is optional -- use whichever you prefer.

ANTHROPIC_API_KEY=sk-ant-your-key-here
