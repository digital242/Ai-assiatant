# Copy this file to ".env" and fill in your keys. The .env file is git-ignored.
# This file holds ONLY secrets. All other settings live in config.yaml.
#
# Sumo also reads these straight from your shell environment, so a .env file is
# optional -- use whichever you prefer.

# Required: your Anthropic (Claude) API key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: only needed if you set tts_backend: "fish" in config.yaml, to use the
# expressive Fish Audio voice instead of the offline one.
FISH_AUDIO_API_KEY=your-fish-audio-key-here
